from PIL import Image, ImageDraw
import math

# размер
W = H = 512
img = Image.new("RGBA", (W, H), (0,0,0,0))
draw = ImageDraw.Draw(img)

# центр
cx, cy = W//2, H//2
outer = 220
inner = 90

# аметистовые градиенты
def star_points(cx, cy, outer, inner, points=5):
    pts = []
    for i in range(points*2):
        angle = math.radians(-90 + i*180/points)
        r = outer if i%2==0 else inner
        x = cx + r*math.cos(angle)
        y = cy + r*math.sin(angle)
        pts.append((x,y))
    return pts

# свечение
for glow in range(6, 0, -1):
    col = (180+glow*10, 130+glow*5, 255, 15)
    pts = star_points(cx, cy, outer+glow*8, inner+glow*3)
    draw.polygon(pts, fill=col)

# основная звезда - аметист
pts = star_points(cx, cy, outer, inner)
draw.polygon(pts, fill=(168, 123, 255, 255), outline=(255,255,255,200))

# грани (блеск)
for i in range(5):
    angle = math.radians(-90 + i*72)
    x1 = cx + inner*0.4*math.cos(angle)
    y1 = cy + inner*0.4*math.sin(angle)
    x2 = cx + outer*math.cos(angle)
    y2 = cy + outer*math.sin(angle)
    draw.line([(cx,cy),(x2,y2)], fill=(255,255,255,180), width=2)

# центр блик
draw.ellipse((cx-8, cy-8, cx+8, cy+8), fill=(255,255,255,220))

img.save("star.png", "PNG")
print("Saved star.png")
